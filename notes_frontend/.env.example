# Frontend -> Backend connectivity (required)
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Fallback if NEXT_PUBLIC_API_BASE is not set
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Health endpoint path (optional; defaults to /healthz)
NEXT_PUBLIC_HEALTHCHECK_PATH=/healthz

# Optional (not used by default in this UI)
NEXT_PUBLIC_WS_URL=
